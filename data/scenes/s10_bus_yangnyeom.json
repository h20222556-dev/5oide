    {
      "speaker": "양념",
      "speakerType": "normal",
      "text": "일반 자전거 뿐만 아니라 둘이 함께 탈 수 있는 자전거도 있거든요.",
      "characters": [
        {
          "id": "yangnyeom",
          "position": "center",
          "expression": "기본"
        }
      ]
    },
    {
      "speaker": "주인공",
      "speakerType": "os",
      "text": "섬 곳곳을 둘러보기에 괜찮겠네요.",
