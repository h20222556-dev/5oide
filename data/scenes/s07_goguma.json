      ]
    },
    {
      "speaker": "주인공",
      "speakerType": "os",
      "text": "{고구마}씨는 항상 여유롭고 다정하신 것 같아요.",
      "characters": [
        {
          "id": "goguma",
          "position": "center",
          "expression": "기본"
        }
